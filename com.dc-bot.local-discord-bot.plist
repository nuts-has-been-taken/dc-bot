<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dc-bot.local-discord-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/carbarcha_huang/.local/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/carbarcha_huang/Documents/dc-bot</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/carbarcha_huang/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>Asia/Taipei</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/carbarcha_huang/Documents/dc-bot/logs/bot.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/carbarcha_huang/Documents/dc-bot/logs/bot.error.log</string>
</dict>
</plist>
