# LLM API 設定
# 請複製此文件為 .env 並填入你的實際設定

# LLM API 金鑰（必填）
LLM_API_KEY=your-api-key-here

# LLM API 端點 URL（必填，OpenAI SDK 的 base_url，不需要包含 /chat/completions）
# 範例：https://api.rdsec.trendmicro.com/prod/aiendpoint/v1
LLM_API_URL=https://api.openai.com/v1

# LLM 模型名稱（選填，預設為 gpt-5）
LLM_MODEL=gpt-5

# Discord Bot 設定

# Discord Bot Token（必填）
# 從 Discord Developer Portal 獲取: https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# ============================================
# API Server 設定（接收外部通知用）
# ============================================

# API Server 監聽地址（選填，預設 0.0.0.0）
# API_HOST=0.0.0.0

# API Server 監聽埠號（選填，預設 8080）
# API_PORT=8080

# API 認證金鑰（選填，用於驗證外部請求）
# 如果不設定，則不進行 API Key 驗證
# DISCORD_BOT_API_KEY=your-api-key-here

# 預設通知頻道 ID（選填）
# 當請求未指定 channel_id 時使用
# DISCORD_DEFAULT_CHANNEL_ID=1234567890123456789
