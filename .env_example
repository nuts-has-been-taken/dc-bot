# Discord Bot Token（必填）
DISCORD_TOKEN=your-discord-bot-token-here

# 斜線指令以外若有 prefix 指令可用（目前保留給 discord.py，預設 "!"）
DISCORD_COMMAND_PREFIX=!

# 需要立即同步斜線指令的 Guild ID（逗號分隔，選填）
# Guild sync 即時生效；全域 sync 最多需等 1 小時
# DISCORD_GUILD_IDS=824957979475968040,另一個GuildID

# Bot 擁有者的 Discord user ID（必填，否則任何人都能要求變更設定）
DISCORD_OWNER_ID=your-discord-user-id-here

# ─────────────────────────────────────────────
# Claude Agent SDK（選填，預設繼承機器上的 claude CLI 認證）
# ─────────────────────────────────────────────
# 若要改用特定模型：
# ANTHROPIC_MODEL=claude-sonnet-5

# 資料沙箱與 session DB 路徑（選填）
# DATA_DIR=./data
# DB_PATH=./src/db/sessions.sqlite

# ─────────────────────────────────────────────
# Brave Search API（選填，websearch 工具用）
# 未設定時 web_search 工具會回傳錯誤提示
# 定價：US$5 / 1,000 次，每月含 US$5 免費額度
# ─────────────────────────────────────────────
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
